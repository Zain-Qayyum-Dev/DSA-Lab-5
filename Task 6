#include <queue>
#include <algorithm>
#include <iostream>
#include <vector>
using namespace std;

struct TreeNode {
    int data;
    TreeNode* parent;
    vector<TreeNode*> children;
};

TreeNode* createNode(int val, TreeNode* parent) {
    TreeNode* n = new TreeNode;
    n->data = val;
    n->parent = parent;
    return n;
}

TreeNode* findNode(TreeNode* root, int val) {
    if (root == nullptr) return nullptr;
    if (root->data == val) return root;
    for (TreeNode* c : root->children) {
        TreeNode* found = findNode(c, val);
        if (found != nullptr) return found;
    }
    return nullptr;
}

bool addChild(TreeNode* root, int parentVal, int val) {
    if (root == nullptr) {
        cout << "Error: tree is empty.\n";
        return false;
    }
    if (findNode(root, val) != nullptr) {
        cout << "Error: value " << val << " already exists.\n";
        return false;
    }
    TreeNode* p = findNode(root, parentVal);
    if (p == nullptr) {
        cout << "Error: parent " << parentVal << " not found.\n";
        return false;
    }
    p->children.push_back(createNode(val, p));
    return true;
}

void bfs(TreeNode* root) {
    if (!root) return;
    queue<TreeNode*> q;
    q.push(root);
    while (!q.empty()) {
        TreeNode* cur = q.front();
        q.pop();
        cout << cur->data << " ";
        for (TreeNode* c : cur->children) q.push(c);
    }
}

void preorder(TreeNode* n) {
    if (!n) return;
    cout << n->data << " ";
    for (TreeNode* c : n->children) preorder(c);
}

void postorder(TreeNode* n) {
    if (!n) return;
    for (TreeNode* c : n->children) postorder(c);
    cout << n->data << " ";
}

void freeSubtree(TreeNode* n) {
    for (TreeNode* c : n->children) freeSubtree(c);
    cout << "Freed: " << n->data << endl;
    delete n;
}

void deleteNode(TreeNode*& root, TreeNode* target) {
    if (!target) return;
    if (target == root) {
        freeSubtree(root);
        root = nullptr;
        return;
    }
    vector<TreeNode*>& sib = target->parent->children;
    sib.erase(remove(sib.begin(), sib.end(), target), sib.end());
    freeSubtree(target);
}

int countNodes(TreeNode* n) {
    if (!n) return 0;
    int total = 1;
    for (TreeNode* c : n->children) total += countNodes(c);
    return total;
}

int height(TreeNode* n) {
    if (!n) return -1;
    int h = 0;
    for (TreeNode* c : n->children) h = max(h, 1 + height(c));
    return h;
}

int countLeaves(TreeNode* n) {
    if (!n) return 0;
    if (n->children.empty()) return 1;
    int total = 0;
    for (TreeNode* c : n->children) total += countLeaves(c);
    return total;
}

void analyze(TreeNode* root, const string& label) {
    cout << "\n=== " << label << " ===" << endl;
    if (!root) { cout << "Tree is empty" << endl; return; }
    cout << "Nodes:      " << countNodes(root) << endl;
    cout << "Height:     " << height(root) << endl;
    cout << "Leaves:     " << countLeaves(root) << endl;
    cout << "BFS:        "; bfs(root);       cout << endl;
    cout << "Pre-order:  "; preorder(root);   cout << endl;
    cout << "Post-order: "; postorder(root); cout << endl;
}

void safeDelete(TreeNode*& root, int value) {
    TreeNode* t = findNode(root, value);
    if (!t) { cout << "Node " << value << " not found" << endl; return; }
    deleteNode(root, t);
}

int main() {
    TreeNode* root = createNode(1, nullptr);
    addChild(root, 1, 2);
    addChild(root, 1, 3);
    addChild(root, 1, 4);
    addChild(root, 2, 5);
    addChild(root, 2, 6);
    addChild(root, 4, 7);

    analyze(root, "ORIGINAL TREE");

    cout << "\nTrying to delete invalid node 99..." << endl;
    safeDelete(root, 99);

    cout << "\nDeleting 2..." << endl;
    safeDelete(root, 2);
    analyze(root, "AFTER DELETING 2");

    cout << "\nDeleting root 1..." << endl;
    safeDelete(root, 1);
    analyze(root, "AFTER DELETING ROOT");

    return 0;
}
